# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-sonnet-4-5
CLAUDE_MODEL=claude-sonnet-4-5

# Optional: always use multi-turn NL→SQL with schema tools (list_tables, get_schema). Higher latency/cost, fewer hallucinated columns.
# Map/spatial questions (e.g. "map of …", "where … crashes") also use this agent automatically even when this is false.
CLAUDE_SQL_AGENT=false

# Browser: stream tool rounds + guardrails + Athena start over SSE. Enabled if CLAUDE_SQL_AGENT=true OR the question looks map/spatial (same heuristic as /api/query/start).
NEXT_PUBLIC_AGENT_SSE=false

# AWS / Athena
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
ATHENA_DATABASE=nyc_tlc
ATHENA_OUTPUT_LOCATION=s3://your-bucket/athena-results/
# Optional: workgroup with bytes-scanned cap configured in AWS console
ATHENA_WORKGROUP=primary

# Auth — single shared password for v1
APP_PASSWORD=change-me

# Optional: Mapbox basemap for result maps (public token; restrict by URL in Mapbox account). If unset, CARTO dark tiles are used.
NEXT_PUBLIC_MAPBOX_TOKEN=

# p8k8 — optional NL→SQL backend (non-spatial; see lib/route.ts)
USE_P8K8=false
P8K8_URL=https://p8k8.example.com
P8K8_AUTH_TOKEN=
# Agent schema registered in p8k8 (scripts/register-p8k8-agent.ts)
P8K8_SCHEMA=nl2sql-nyc
# Stable UUID for POST /chat/{uuid} (p8k8 requires a UUID path). Optional: code defaults to f6e3c2b1-a8d7-4e91-bc0d-1a2b3c4d5e6f if unset.
# P8K8_CHAT_ID=
