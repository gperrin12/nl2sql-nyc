# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-sonnet-4-5
CLAUDE_MODEL=claude-sonnet-4-5
# Faster model for /trivia (defaults to Haiku if unset)
TRIVIA_CLAUDE_MODEL=claude-3-5-haiku-20241022

# Optional: always use multi-turn NL→SQL with schema tools (list_tables, get_schema). Higher latency/cost, fewer hallucinated columns.
# Map/spatial questions (e.g. "map of …", "where … crashes") also use this agent automatically even when this is false.
CLAUDE_SQL_AGENT=false

# Browser: live agent trace + guardrails + Athena over SSE (POST /api/query/agent-stream). Works with USE_P8K8, CLAUDE_SQL_AGENT, spatial questions, or direct Claude.
NEXT_PUBLIC_AGENT_SSE=false

# AWS / Athena
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
ATHENA_DATABASE=nyc_tlc
ATHENA_OUTPUT_LOCATION=s3://your-bucket/athena-results/
# Optional: workgroup with bytes-scanned cap configured in AWS console
ATHENA_WORKGROUP=primary

# Postgres (nl2sql.query_runs) — required for logging UI queries to nl2sql.query_runs.
# Local: SSH tunnel → 127.0.0.1:15432 maps to Lightsail localhost:5489
# DATABASE_URL=postgresql://p8:PASSWORD@127.0.0.1:15432/p8
# Vercel: Lightsail public IP, port 5489, NOT localhost. p8k8 Docker Postgres has no TLS — use sslmode=disable.
# DATABASE_URL=postgresql://p8:PASSWORD@YOUR_LIGHTSAIL_PUBLIC_IP:5489/p8?sslmode=disable
# After deploy: open https://YOUR_APP.vercel.app/api/query/log — expect {"configured":true,"connected":true}
# Optional override for nl2sql.query_runs.app_version. If unset: short git SHA at build
# (next.config → GIT_COMMIT_SHA), then VERCEL_GIT_COMMIT_SHA on Vercel, then package.json version.
# APP_VERSION=2025-05-22-agent-v2

# Auth disabled in app (lib/auth.ts). Optional — only for scripts that POST to a password-protected deployment:
# APP_PASSWORD=change-me

# Optional: Mapbox basemap for result maps (public token; restrict by URL in Mapbox account). If unset, CARTO dark tiles are used.
NEXT_PUBLIC_MAPBOX_TOKEN=

# p8k8 — optional NL→SQL backend (non-spatial; see lib/route.ts)
USE_P8K8=false
# Mirror USE_P8K8 on the client so the UI uses /api/query/agent-stream (agent trace panel). Rebuild after changing.
NEXT_PUBLIC_USE_P8K8=false
P8K8_URL=https://p8k8.example.com
P8K8_AUTH_TOKEN=
# Agent schema registered in p8k8 (scripts/register-p8k8-agent.ts)
P8K8_SCHEMA=nl2sql-nyc
# Stable UUID for POST /chat/{uuid} and GET /moments/session/{uuid} (dashboard). Optional: code defaults to f6e3c2b1-a8d7-4e91-bc0d-1a2b3c4d5e6f if unset.
# P8K8_CHAT_ID=

# Dashboard + eval script query source: auto (Postgres if DATABASE_URL set, else p8k8)
# DASHBOARD_SOURCE=postgres
# EVAL_SOURCE=postgres
# EVAL_APP_VERSION=all        (default: current deploy SHA for npm run eval only)
# Dashboard API: ?appVersion=current | SHA | all (default: latest run per question, any deploy)

# Run question bank + log to Postgres + judge (no browser):
#   npm run run:eval          direct mode — uses .env backends + DATABASE_URL + Athena
#   npm run run:eval:full     SQL + Athena result + viz judge
#   npm run run:eval:remote   via APP_URL (deployment env vars)
#   RUN_LIMIT=5 SEED_CATEGORY=spatial npm run run:eval

# Golden baseline eval (data/golden-dataset.json — agent only, app_version=v3-baseline):
#   npm run eval:golden:dry
#   npm run eval:golden
#   RUN_LIMIT=1 npm run eval:golden
#   EVAL_APP_VERSION=v3-baseline npm run eval   (re-judge rows already logged)

# /dashboard: nl2sql.query_runs when DATABASE_URL is set (default). Legacy p8k8: DASHBOARD_SOURCE=p8k8 + P8K8_* below.
# NL→SQL latency is saved to .data/query-metrics.json locally (gitignored). On Vercel, latency is skipped (read-only disk); dashboard shows — for latency.
#
# Full eval replay (npm run eval:full — app must be running, e.g. npm run dev)
# Re-score every question in evals.json + p8k8 and replace S3 evals: npm run eval:refresh
APP_URL=http://localhost:3000
# APP_PASSWORD=...  (same as app auth; omit only if APP_PASSWORD is unset on the app)
REPLAY_DELAY_MS=2000

# Judge seed bank (npm run eval:seed — reads data/seed-results.json, writes data/evals.json)
# ANTHROPIC_API_KEY=...  (required)
# JUDGE_DELAY_MS=600
# JUDGE_FORCE=true         re-judge question+sql pairs that already have resultEval
# SEED_IDS=agg-001,...     same filters as npm run seed
# SEED_CATEGORY=spatial
# SEED_STATUS=succeeded

# Judge scores (npm run eval): required on Vercel — store in S3, not the server filesystem.
# Set the same URI locally when running eval so uploads match what production reads.
# EVALS_S3_URI=s3://your-bucket/path/evals.json

# Trivia global hi-scores (updated automatically after each qualifying 10-question run).
# Same AWS creds as Athena. Without this, dev uses data/trivia-hiscores.json only.
# HISCORES_S3_URI=s3://your-bucket/nl2sql-nyc/trivia-hiscores.json

# Register script only: per-agent LLM (p8k8 json_schema.model), e.g. openai:gpt-4o. Re-run npm run register-agent after changing.
# P8K8_AGENT_MODEL=openai:gpt-4o
# Server-wide default for all agents: set P8_DEFAULT_MODEL on your p8k8 deployment (not this app).
