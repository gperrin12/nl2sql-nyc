[
  {
    "id": "agg-014",
    "question": "What is the 311 complaint rate per 1000 residents by borough in 2024 using ACS 2023 population?",
    "category": "aggregation",
    "difficulty": "hard",
    "ground_truth_answer": "Complaints per 1,000 residents (2024 311, ACS 2023 population): Bronx 520.0, Manhattan 444.0, Brooklyn 394.9, Queens 354.9, Staten Island 246.0.",
    "expected_sql_pattern": "WITH boro_pop AS (SELECT ct.boroname AS boro, SUM(TRY_CAST(TRIM(REGEXP_REPLACE(ctd.total_pop_2023, ',', '')) AS DOUBLE)) AS sum_pop_2023 FROM census_tract_demographics ctd JOIN census_tracts ct ON TRIM(CAST(ct.geoid AS VARCHAR)) = TRIM(CAST(ctd.geoid AS VARCHAR)) GROUP BY 1), complaints_2024_311 AS (SELECT borough AS boro, COUNT(unique_key) AS complaint_count FROM nyc_311 WHERE year = '2024' GROUP BY 1) SELECT b.boro, ROUND(1000.0 * c.complaint_count / b.sum_pop_2023, 1) AS complaints_per_1k FROM boro_pop b LEFT JOIN complaints_2024_311 c ON UPPER(b.boro) = c.boro ORDER BY complaints_per_1k DESC"
  },
